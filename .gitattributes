# Normaliza los finales de linea. Se desarrolla en Windows pero el CI corre en
# Linux: un script con CRLF falla ahi con "bad interpreter".
* text=auto eol=lf

# Los scripts de shell y el SQL SIEMPRE con LF, sin excepcion.
*.sh   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Binarios: que git no los toque.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
