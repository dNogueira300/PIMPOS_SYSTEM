{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pimpos-validacion-ci-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "pimpos-validacion-ci-local" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "pimpos-ci-local-cache" }],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "pimpos-ci-local-tags",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "images": { "binding": "IMAGES", "remote": false },
  "workers_dev": false,
  "preview_urls": false
}
