# Plantilla de variables de entorno — PIMPOS_SYSTEM
# Copiar a .env.local y completar los valores. .env.local NUNCA se commitea.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SOLO servidor. Nunca con prefijo NEXT_PUBLIC_

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=51947874820    # R4, R17

# --- Correo (R12) ---
RESEND_API_KEY=
CORREO_ALERTAS=contactopimpos@gmail.com

# --- Supabase local (supabase start) ---
# Para desarrollar contra la instancia local en Docker (opción A del plan), los
# valores de NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY y
# SUPABASE_SERVICE_ROLE_KEY salen del comando:
#
#   supabase status
#
# Ese comando imprime la API URL (normalmente http://127.0.0.1:54321) y las
# llaves anon y service_role de la instancia local. No hay que inventarlas ni
# copiarlas a mano desde el panel de Supabase: son fijas del entorno local y se
# regeneran solas en cada `supabase start`.
#
# Las llaves del proyecto remoto (pimpos-produccion) viven en el gestor de
# contraseñas y en las variables de entorno de Vercel; no van en este archivo.
